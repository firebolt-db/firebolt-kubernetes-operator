        },
        "managed_table_storage": {
          "default": "s3",
          "type": "string"
        },
        "persistent_disk": {
          "additionalProperties": false,
          "properties": {
            "backend": {
              "default": "auto",
              "description": "Disk IO backend: 'auto', 'uring' or 'pread'.",
              "type": "string"
            },
            "backend_inflight_bytes": {
              "default": "5MiB",
              "description": "Cap on bytes the disk IO backend keeps in flight.",
              "type": "string"
            },
            "fsync_on_commit": {
              "default": false,
              "description": "Fsync tablet files and directories before acknowledging a local commit.",
              "type": "boolean"
            },
            "pread_threads": {
              "default": 32,
              "description": "Thread count of the pread backend.",
              "type": "integer"
            }
          },
          "type": "object"
        },
        "tablet_recovery_cache": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
