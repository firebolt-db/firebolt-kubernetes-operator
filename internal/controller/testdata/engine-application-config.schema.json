              "type": "boolean"
            },
            "backend": {
              "default": "auto",
              "description": "Disk IO backend: 'auto', 'uring' or 'pread'.",
              "type": "string"
            },
            "backend_inflight_bytes": {
              "default": "5MiB",
              "description": "Cap on bytes the disk IO backend keeps in flight.",
              "type": "string"
            },
            "chunk_bytes": {
              "default": "2MiB",
              "description": "Granularity at which misses are fetched, cached and evicted, and the size of one object-storage GET.",
              "type": "string"
            },
            "directory": {
              "default": "",
              "description": "Absolute path of the cache directory. Defaults to an 'io_disk_cache' subdirectory of the temporary disk.",
              "type": "string"
            },
            "dump_interval": {
              "default": "10s",
              "description": "How often the chunk index is persisted to disk.",
              "type": "string"
            },
            "enabled": {
              "default": true,
              "description": "Enable the scan disk cache.",
              "type": "boolean"
            },
            "evict_min_age": {
              "default": "10m",
              "description": "Entries used more recently than this are not evicted until free space falls below 'free_hard_watermark_ratio'.",
              "type": "string"
            },
            "free_hard_watermark_ratio": {
              "default": 0.2,
              "description": "Below this fraction free, evict regardless of age. Must not be above 'free_low_watermark_ratio'.",
              "type": "number"
            },
            "free_high_watermark_ratio": {
              "default": 0.4,
              "description": "Evict until the fraction of the cache device that is free is back above this. Must not be below 'free_low_watermark_ratio'.",
              "type": "number"
            },
            "free_low_watermark_ratio": {
              "default": 0.4,
              "description": "Start evicting when the fraction of the cache device that is free falls below this, sparing anything used within 'evict_min_age'.",
              "type": "number"
            },
            "pread_threads": {
