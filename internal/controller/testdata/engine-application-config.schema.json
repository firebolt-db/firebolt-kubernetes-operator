{
  "$id": "https://docs.firebolt.io/schemas/application-config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data_source_encryption": {
      "additionalProperties": false,
      "properties": {
        "decrypted_cache_timeout_ms": {
          "default": 600000,
          "description": "How long, in milliseconds, a decrypted data-source credential is cached in memory.",
          "type": "integer"
        },
        "kms_arn": {
          "default": "",
          "description": "ARN of the KMS key used to encrypt data-source credentials.",
          "type": "string"
        },
        "local_kms": {
          "additionalProperties": false,
          "description": "Connection settings for the local KMS service. Required when 'mode' is 'local_kms'.",
          "properties": {
            "access_key": {
              "description": "Access key for the local KMS service.",
              "type": "string"
            },
            "endpoint": {
              "description": "Endpoint URL of the local KMS service.",
              "type": "string"
            },
            "secret_key": {
              "description": "Secret key for the local KMS service.",
              "type": "string"
            }
          },
          "required": [
            "access_key",
            "endpoint",
            "secret_key"
          ],
          "type": "object"
        },
        "mode": {
          "default": "plaintext",
          "description": "How external data-source credentials are protected before they are stored in the metadata service: 'plaintext', 'aws_kms' or 'local_kms'.",
          "type": "string"
        },
        "skip_s3_access_check": {
          "default": false,
          "description": "Skip validating S3 access when creating an external location or table. Useful when credentials are placeholders.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "endpoints": {
      "additionalProperties": false,
      "properties": {
        "http": {
          "additionalProperties": false,
          "properties": {
            "listeners": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer"
                  },
                  "tls": {
                    "additionalProperties": false,
                    "properties": {
                      "certificate_file": {
                        "type": "string"
                      },
                      "private_key_file": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": {
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "postgres": {
          "additionalProperties": false,
          "properties": {
            "listeners": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer"
                  },
                  "tls": {
                    "additionalProperties": false,
                    "properties": {
                      "certificate_file": {
                        "type": "string"
                      },
                      "private_key_file": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": {
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "unix_socket_only": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "engine": {
      "additionalProperties": false,
      "properties": {
        "auto_vacuum": {
          "additionalProperties": false,
          "properties": {
            "assessment_frequency": {
              "type": "integer"
            },
            "debug_sleep_before_commit_ms": {
              "type": "integer"
            },
            "debug_sleep_in_merge_loop_ms": {
              "type": "integer"
            },
            "enabled": {
              "type": "boolean"
            },
            "fb_catalog_enabled": {
              "type": "boolean"
            },
            "max_tablet_bytes": {
              "type": "string"
            },
            "max_tablets_in_job": {
              "type": "integer"
            },
            "memory_allowance": {
              "type": "number"
            },
            "min_bad_tablets_threshold": {
              "type": "integer"
            },
            "num_workers_per_node": {
              "type": "integer"
            },
            "periodic_check_interval_s": {
              "type": "integer"
            },
            "periodic_scan_min_reschedule_interval_s": {
              "type": "integer"
            },
            "run_on_first_dml": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "cluster_id": {
          "type": "string"
        },
        "cluster_ordinal": {
          "type": "integer"
        },
        "eviction": {
          "additionalProperties": false,
          "properties": {
            "max_tablets_per_mb_of_total_memory": {
              "default": 1.5,
              "type": "number"
            },
            "prefetch_space_ratio_threshold": {
              "default": 0.13,
              "type": "number"
            },
            "tablet_eviction_soft_threshold": {
              "default": 0.4,
              "type": "number"
            },
            "tablet_eviction_threshold": {
              "default": 0.2,
              "type": "number"
            },
            "tablet_min_ttl_before_memory_eviction_seconds": {
              "default": 1800,
              "type": "integer"
            },
            "tablet_ttl_before_full_eviction_seconds": {
              "default": 21600,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "id": {
          "default": "default-engine-id",
          "type": "string"
        },
        "listen_host": {
          "type": "string"
        },
        "max_server_memory_usage": {
          "default": "0B",
          "type": "string"
        },
        "max_server_memory_usage_headroom_bytes": {
          "default": "0B",
          "type": "string"
        },
        "max_server_memory_usage_to_ram_ratio": {
          "default": 0.9,
          "type": "number"
        },
        "metrics_collection_frequency_per_minute": {
          "default": 12,
          "type": "integer"
        },
        "multi_cluster": {
          "additionalProperties": false,
          "properties": {
            "broadcast_endpoint": {
              "type": "string"
            },
            "broadcast_ssl_enabled": {
              "default": false,
              "type": "boolean"
            },
            "broadcast_tuple_limit_per_engine_cluster": {
              "default": 0,
              "type": "integer"
            }
          },
          "required": [
            "broadcast_endpoint"
          ],
          "type": "object"
        },
        "nodes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "aragog_port": {
                "default": 5678,
                "type": "integer"
              },
              "health_check_port": {
                "default": 8122,
                "type": "integer"
              },
              "host": {
                "type": "string"
              },
              "prometheus_port": {
                "default": 9090,
                "type": "integer"
              },
              "shufflepuff_port": {
                "default": 16000,
                "type": "integer"
              },
              "storage_agent_port": {
                "default": 3434,
                "type": "integer"
              },
              "storage_manager_port": {
                "default": 1717,
                "type": "integer"
              }
            },
            "required": [
              "host"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "query_cache_memory_fraction": {
          "default": 0.2,
          "type": "number"
        },
        "termination_grace_period": {
          "default": "1m",
          "type": "string"
        },
        "vector_index_cache_memory_fraction": {
          "default": 0.5,
          "type": "number"
        }
      },
      "type": "object"
    },
    "execution": {
      "additionalProperties": false,
      "properties": {
        "admission_controller": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "max_concurrent_admitted_queries": {
              "default": 100,
              "type": "integer"
            },
            "max_required_relative_memory_for_retry": {
              "default": 0.75,
              "type": "number"
            },
            "max_retries_per_query": {
              "default": 3,
              "type": "integer"
            },
            "parallelism_adaptive_ema_alpha": {
              "default": 0.3,
              "type": "number"
            },
            "parallelism_fair_share_k": {
              "default": 1.5,
              "type": "number"
            },
            "parallelism_floor": {
              "default": 4,
              "type": "integer"
            },
            "parallelism_policy": {
              "default": "none",
              "type": "string"
            },
            "parallelism_soft_ceiling": {
              "default": 0,
              "type": "integer"
            },
            "parallelism_static_cap": {
              "default": 16,
              "type": "integer"
            },
            "reduce_required_memory_after_seconds_at_front_of_queue": {
              "default": 10,
              "type": "integer"
            },
            "seconds_between_no_admission_warnings": {
              "default": 3600,
              "type": "integer"
            },
            "seconds_until_no_admission_warning": {
              "default": 300,
              "type": "integer"
            },
            "total_memory_tracker_hard_limit_ratio": {
              "default": 0.9,
              "type": "number"
            }
          },
          "type": "object"
        },
        "admission_controller_reserve_internal_query_lane": {
          "default": true,
          "type": "boolean"
        },
        "ai_mutations_mode": {
          "default": "reevaluate",
          "type": "string"
        },
        "allow_amazon_bedrock": {
          "default": true,
          "type": "boolean"
        },
        "buffer_manager_block_size": {
          "default": "2MiB",
          "description": "Block size used when fetching data through the external scan buffer manager.",
          "type": "string"
        },
        "enable_distributed_shuffle": {
          "default": true,
          "type": "boolean"
        },
        "fetcher_max_thread_count": {
          "default": 1024,
          "description": "Maximum number of threads in the fetcher thread pool. Threads above 'fetcher_min_thread_count' start only when queued reads need them.",
          "type": "integer"
        },
        "fetcher_min_thread_count": {
          "default": 128,
          "description": "Minimum number of threads in the fetcher thread pool, and the number started at startup. Must not be above 'fetcher_max_thread_count'. An equal minimum and maximum give a fixed thread pool.",
          "type": "integer"
        },
        "fetcher_threads_per_vcpu": {
          "default": 8,
          "description": "Threads per usable vCPU in the fetcher thread pool, which reads scan data from object storage and local files. The product, clamped to ['fetcher_min_thread_count', 'fetcher_max_thread_count'], is the ceiling the pool may grow to. 0 pins the ceiling to the minimum.",
          "type": "integer"
        },
        "hybrid_headers_format_version": {
          "default": 3,
          "type": "integer"
        },
        "hybrid_headers_primary_index_compression_level": {
          "default": 2,
          "type": "integer"
        },
        "hybrid_headers_primary_index_compression_method": {
          "default": "BROTLI",
          "type": "string"
        },
        "io_uring": {
          "default": "fail_on_first_use",
          "type": "string"
        },
        "max_threads": {
          "default": 0,
          "type": "integer"
        },
        "merge_committed_tablets": {
          "default": true,
          "type": "boolean"
        },
        "min_bytes_for_wide_part": {
          "default": 104857600,
          "type": "integer"
        },
        "regexp_cache_max_keys": {
          "default": 10000,
          "type": "integer"
        },
        "storage_manager_cache_tablets_on_proxy": {
          "default": true,
          "type": "boolean"
        },
        "umask": {
          "description": "Octal file-mode creation mask for the process. Defaults to '0007' (owner + group, no access for others), which keeps runtime-created files group-accessible for the OpenShift arbitrary-UID model. Use '0077' for owner-only.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "instance": {
      "additionalProperties": false,
      "properties": {
        "account_name": {
          "default": "default-account",
          "type": "string"
        },
        "auth": {
          "additionalProperties": false,
          "properties": {
            "admin": {
              "additionalProperties": false,
              "description": "The Instance admin — required when auth is enabled.",
              "properties": {
                "name": {
                  "default": "firebolt",
                  "description": "Admin username (default: \"firebolt\")",
                  "type": "string"
                },
                "password_env": {
                  "description": "Environment variable name to read the password from at startup",
                  "type": "string"
                },
                "password_file": {
                  "description": "Absolute path to a file containing the password; trailing newline trimmed",
                  "type": "string"
                },
                "password_value": {
                  "description": "Password literal (development use only)",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "enabled": {
              "default": false,
              "description": "Whether authentication is enabled",
              "type": "boolean"
            },
            "local": {
              "additionalProperties": false,
              "description": "Embedded Authorization Server internals (signing keys, algorithm, JWT parameters). Defaulted; the operator-facing schema treats this block as optional.",
              "properties": {
                "jwt": {
                  "additionalProperties": false,
                  "description": "JWT parameters for the embedded Authorization Server",
                  "properties": {
                    "clock_skew_tolerance": {
                      "default": "30s",
                      "description": "Clock skew tolerance for JWT temporal claim validation",
                      "type": "string"
                    },
                    "max_token_age": {
                      "default": "1d",
                      "description": "Maximum token age based on iat claim",
                      "type": "string"
                    },
                    "token_expiry": {
                      "default": "1h",
                      "description": "Token lifetime for issued access tokens",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "signing_algorithm": {
                  "default": "RS256",
                  "description": "Signing algorithm for issued tokens",
                  "type": "string"
                },
                "signing_keys": {
                  "description": "Signing key entries. Empty => dev auto-generate mode.",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "description": "Key identifier",
                        "type": "string"
                      },
                      "private_key_path": {
                        "description": "Filesystem path to PEM private key",
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "private_key_path"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "oidc": {
              "additionalProperties": false,
              "description": "OIDC authentication configuration.",
              "properties": {
                "jwt": {
                  "additionalProperties": false,
                  "description": "JWT parameters",
                  "properties": {
                    "clock_skew_tolerance": {
                      "default": "30s",
                      "description": "Clock skew tolerance for JWT temporal claim validation",
                      "type": "string"
                    },
                    "max_token_age": {
                      "default": "1d",
                      "description": "Maximum token age based on iat claim",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "providers": {
                  "description": "Trusted OIDC providers. At least one entry when `oidc:` is present.",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "audience": {
                        "description": "Expected `aud` claim for tokens minted by this provider. When omitted, the engine's canonical Instance URL is used.",
                        "type": "string"
                      },
                      "discovery": {
                        "additionalProperties": false,
                        "description": "Discovery document refresh configuration",
                        "properties": {
                          "refresh_interval": {
                            "default": "1d",
                            "description": "OpenID Configuration document refresh interval",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "discovery_url": {
                        "description": "OpenID Connect Discovery endpoint URL. Sugar for `target.discovery_url`; set exactly one of `discovery_url` or `target`.",
                        "type": "string"
                      },
                      "exchange": {
                        "additionalProperties": false,
                        "description": "RFC 8693 token-exchange server whose issuer the Engine trusts. When omitted the provider is single-hop and the Engine trusts the target directly.",
                        "properties": {
                          "discovery_url": {
                            "description": "RFC 8414 Discovery endpoint URL of the token-exchange server. Its issuer is the provider's trusted issuer.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "discovery_url"
                        ],
                        "type": "object"
                      },
                      "jit_provisioning": {
                        "additionalProperties": false,
                        "description": "JIT (Just-In-Time) provisioning: auto-create users on first login",
                        "properties": {
                          "default_roles": {
                            "description": "Roles assigned to JIT-provisioned users. Defaults to [public] when omitted (also the typical single-element value at launch); the array shape is forward-compatible with future role-additivity semantics.",
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "enabled": {
                            "default": false,
                            "description": "Whether just-in-time user provisioning is enabled",
                            "type": "boolean"
                          }
                        },
                        "type": "object"
                      },
                      "jwks": {
                        "additionalProperties": false,
                        "description": "JWKS cache configuration",
                        "properties": {
                          "cache_ttl": {
                            "default": "1h",
                            "description": "JWKS document cache TTL",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "name": {
                        "description": "Provider name / machine identifier (used in ?authorization_server=<name> and CLI flags)",
                        "type": "string"
                      },
                      "target": {
                        "additionalProperties": false,
                        "description": "The server clients authenticate at. Set exactly one of `discovery_url` or `target`.",
                        "properties": {
                          "discovery_url": {
                            "description": "OpenID Connect / RFC 8414 Discovery endpoint URL of the IdP clients authenticate at",
                            "type": "string"
                          },
                          "token_endpoint_auth_method": {
                            "description": "Client authentication method pin for the target's token endpoint (e.g. \"client_secret_post\"). Advertised to clients for IdPs whose discovery document omits `token_endpoint_auth_methods_supported`; not interpreted by the Engine.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "discovery_url"
                        ],
                        "type": "object"
                      },
                      "title": {
                        "description": "Human-readable label shown by interactive UIs. Defaults to `name` when omitted.",
                        "type": "string"
                      },
                      "username_mapping": {
                        "description": "Username mapping template (e.g. \"{{ email }}\", \"{{ sub }}\", \"{{ iss }}|{{ sub }}\")",
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "username_mapping"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "password_login": {
              "default": "admin_only",
              "description": "Default PASSWORD_LOGIN policy: admin_only (default) or any_user. Ignored when oidc is absent.",
              "type": "string"
            },
            "preferred_authorization_server": {
              "description": "Name of the authorization server clients should use by default when the connection does not select one explicitly. Must name a configured server: the embedded '_local' server or an oidc.providers[].name. Advisory to clients; surfaced as preferredAuthorizationServer in /.well-known/firebolt.",
              "type": "string"
            }
          },
          "type": "object"
        },
        "disable_startup_health_check": {
          "default": false,
          "type": "boolean"
        },
        "duck_catalog": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "default": false,
              "description": "Store engine metadata in a DuckLake catalog served from inside the engine process instead of the co-located metadata service.",
              "type": "boolean"
            },
            "in_memory": {
              "default": false,
              "description": "Hold the DuckLake catalog entirely in RAM. Nothing is written to the filesystem and ALL engine metadata is lost when the process exits, so this is for local development, benchmarking and hermetic tests rather than for storing anything you want to keep. This is the default when the catalog is enabled and neither 'pg_url' nor 'sqlite_path' is given; set it explicitly to say so in the config. Single-node use only, and mutually exclusive with 'pg_url' and 'sqlite_path'.",
              "type": "boolean"
            },
            "pg_url": {
              "default": "",
              "description": "Connection string of the PostgreSQL database holding the DuckLake catalog, for example 'postgresql://user:password@host:5432/dbname'. Mutually exclusive with 'sqlite_path' and 'in_memory'.",
              "type": "string"
            },
            "sqlite_path": {
              "default": "",
              "description": "Path to the SQLite file holding the account-level DuckLake catalog. Each Firebolt database gets a catalog file of its own, in a `<sqlite_path>.databases/` directory beside it. Single-node use only: the files are not shared between engine nodes. Mutually exclusive with 'pg_url' and 'in_memory'.",
              "type": "string"
            }
          },
          "type": "object"
        },
        "id": {
          "default": "01kp98j0000000000000000000",
          "type": "string"
        },
        "multi_engine": {
          "additionalProperties": false,
          "properties": {
            "metadata_endpoint": {
              "type": "string"
            }
          },
          "required": [
            "metadata_endpoint"
          ],
          "type": "object"
        },
        "organization_id": {
          "default": "01kp98j0000000000000000001",
          "type": "string"
        },
        "organization_name": {
          "default": "default-org",
          "type": "string"
        },
        "type": {
          "default": "single_engine",
          "type": "string"
        }
      },
      "type": "object"
    },
    "logging": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "level": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "level",
              "name"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "format": {
          "default": "json",
          "type": "string"
        },
        "level": {
          "default": "info",
          "type": "string"
        },
        "sinks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "file": {
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ],
                "type": "object"
              },
              "level": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "otel": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "endpoint": {
          "default": "",
          "type": "string"
        },
        "protocol": {
          "default": "http/protobuf",
          "type": "string"
        }
      },
      "type": "object"
    },
    "planner": {
      "additionalProperties": false,
      "properties": {
        "automated_column_statistics": {
          "additionalProperties": false,
          "properties": {
            "cache_max_size_bytes": {
              "default": 104857600,
              "type": "integer"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "python_udf": {
      "additionalProperties": false,
      "properties": {
        "execution_mode": {
          "default": "disabled",
          "description": "How the engine isolates the Python interpreter that executes UDF code: `disabled` (default) executes no UDF code at all, `sandboxed` runs each worker in a Docker container of its own, `unsandboxed` runs it as a child process of the engine, where UDF code can do anything the engine's operating system user can.",
          "type": "string"
        },
        "root_dir": {
          "description": "Directory holding the Python environments, downloaded packages and worker scripts of Python UDFs. Defaults to `udf` under the engine's temporary directory.",
